# Connection string Neon untuk npm run dev dan script db:* di laptop
# (Dashboard Neon → Connect → role neondb_owner, Connection pooling ON).
# Saat deploy ke Neon Functions, DATABASE_URL diisi otomatis oleh Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Rahasia untuk menandatangani token login, ikut dikirim oleh npm run deploy.
# Buat dengan: openssl rand -base64 48
JWT_SECRET=
