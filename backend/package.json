{
  "name": "pos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file=.env.local scripts/dev.ts",
    "typecheck": "tsc",
    "deploy": "node --env-file=.env.local scripts/deploy.mjs",
    "db:schema": "node --env-file=.env.local scripts/apply-schema.mjs",
    "db:init-sql": "node scripts/build-init-sql.mjs",
    "db:export": "node --env-file=.env.local scripts/export-supabase.mjs",
    "db:import": "node --env-file=.env.local scripts/import-export.mjs",
    "user:create": "node --env-file=.env.local scripts/create-user.mjs",
    "menu:art": "node menu-art/generate.mjs",
    "menu:photos": "node --env-file=.env.local scripts/upload-menu-photos.mjs",
    "supabase:wipe": "node --env-file=.env.local scripts/wipe-supabase.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neon/functions": "^0.11.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.8",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "neon": "^9.5.0",
    "typescript": "^5"
  }
}
